# ==============================================================================
# EduInsight Learning Analytics - Environment Configuration
# File: .env.example
# ==============================================================================
# LƯU Ý: Không commit file .env chứa token thật lên repository Git!
# Copy file này thành .env và điền các giá trị tài khoản Cloudflare của bạn.

# 1. Thông tin tài khoản Cloudflare
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here

# 2. Cloudflare D1 Database ID (Lấy sau khi chạy: npx wrangler d1 create eduinsight-db)
CLOUDFLARE_D1_DATABASE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# 3. Cloudflare R2 Bucket Name (Lấy sau khi chạy: npx wrangler r2 bucket create eduinsight-storage)
CLOUDFLARE_R2_BUCKET_NAME=eduinsight-storage

# 4. Cấu hình môi trường chạy
ENVIRONMENT=development
PORT=8787
