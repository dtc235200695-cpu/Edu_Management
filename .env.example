# Shared configuration. Only VITE_* values are exposed in frontend assets.
VITE_API_BASE_URL=/api
PORT=8787
APP_URL=http://localhost:5173
GOOGLE_REDIRECT_URI=http://localhost:8787/auth/google/callback

# Server-only credentials. Generate SESSION_SECRET with at least 32 random bytes,
# for example: openssl rand -base64 32
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=

# Set to true when serving over HTTPS.
COOKIE_SECURE=false
