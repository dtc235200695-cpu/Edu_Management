# Copy this file to .env and update the values for your environment.
# The Cloudflare Worker cannot read this local file; keep its secret in sync
# with the Worker secret configured through Wrangler.
VITE_API_BASE_URL=/api
PORT=8787
APP_URL=http://localhost:5173
GOOGLE_REDIRECT_URI=http://localhost:8787/auth/google/callback
CLOUDFLARE_WORKER_URL=https://learnwise-d1-api.hoanghai69205.workers.dev
LEARNWISE_API_SECRET=
ADMIN_EMAIL=hoanghai69205@gmail.com

# Server-only credentials. Generate SESSION_SECRET with at least 32 random bytes,
# for example: openssl rand -base64 32
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=

# Set to true when serving over HTTPS. Production also enables Secure cookies.
COOKIE_SECURE=false

# SMTP settings used for temporary passwords and password reset codes.
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
